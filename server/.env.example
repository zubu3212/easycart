PORT=5000
# Local development with the built-in PostgreSQL (no install needed):
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5433/easycart?schema=public"  and  EMBEDDED_DB=true
# Own/hosted PostgreSQL (Neon, Supabase...): put its URL here and set EMBEDDED_DB=false
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/easycart?schema=public"
EMBEDDED_DB=false
# Required. Production needs 32+ random characters: openssl rand -hex 32
JWT_SECRET=
# Production only: your frontend URL(s), comma separated, e.g. https://easycart.vercel.app
# If empty in production, other domains are blocked by CORS.
CLIENT_URL=
# true = demo "pay by card" (marks orders paid WITHOUT charging). Keep false/empty on a live site.
DEMO_CARD_PAYMENTS=false
# Optional: admin password for the seed/admin scripts (remote DB without it gets a random one, printed once)
ADMIN_PASSWORD=
ADMIN_EMAIL=
