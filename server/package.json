{
  "name": "easycart-server",
  "version": "2.0.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:server": "tsx watch server.js",
    "start": "tsx server.js",
    "build": "prisma generate",
    "setup": "node scripts/setup.js",
    "db:start": "node scripts/db.js",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:setup": "prisma generate && prisma migrate dev --name init",
    "seed": "tsx prisma/seed.js",
    "seed:reset": "tsx prisma/seed.js --reset",
    "admin": "tsx createAdmin.js",
    "studio": "prisma studio"
  },
  "dependencies": {
    "@netlify/database": "^2.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "embedded-postgres": "17.10.0-beta.17",
    "prisma": "7.10.0",
    "tsx": "^4.19.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
